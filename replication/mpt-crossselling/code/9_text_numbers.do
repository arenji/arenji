/*==============================================================================
9_text_numbers.do -- descriptive numbers quoted in the text but shown in no
table or figure. Written to $tables/text_numbers.txt.

  Section 4.1  within-bank-year dispersion of effective deposit rates
               (mean / median / p25 of the within-bank-year SD, and the SD of
               that SD across bank-years), from the relationship panel
  Section 4.1  number of municipalities per bank (median, 5th percentile)
  Section 4.3  loan-growth sample: number of banks, municipalities, and
               average number of banks per municipality
  Section 3.3  range of the policy rate and of its year-on-year change

Other quoted numbers are produced where the related exhibit is made:
  Table A1 variance decomposition -> 4_tables_pricing.do  (a4_ao_variance_decomposition.txt)
  Low-rate spreads vs. benchmarks  -> 7_figures.do         (lowrate_descriptives.txt)
  Sec. 5.1 slope of beta on PrB, Fig. 3 mean/median, Fig. A1 correlation -> 7_figures.do (log)
==============================================================================*/

* Helper programs and globals come from config.do; reload it if they are missing
capture quietly program list write_table
if _rc {
    if "$root" == "" global root "`c(pwd)'"
    do "$root/code/config.do"
}

file open ft using "$tables/text_numbers.txt", write replace
file write ft "Numbers quoted in the text (generated by 9_text_numbers.do)" _n _n

*---- Section 3.3: policy rate range ---------------------------------------------
use "$f_prate", clear
qui sum prate2
file write ft "Sec 3.3  policy rate, annual average: min = " %5.2f (r(min)) "  max = " %5.2f (r(max)) _n
qui sum d_prate2
file write ft "Sec 3.3  year-on-year change in the policy rate: min = " %5.2f (r(min)) "  max = " %5.2f (r(max)) _n _n

*---- Section 4.1: within-bank-year dispersion of effective deposit rates ---------
use bankid year deprate deposits using "$work/relid_withconv.dta", clear
keep if deposits > 0 & deposits != . & deprate != .
collapse (sd) sd_rate = deprate (count) n = deprate, by(bankid year)
keep if n >= 2
qui sum sd_rate, detail
file write ft "Sec 4.1  within-bank-year SD of effective deposit rates (pp):" _n
file write ft "         mean = " %5.2f (r(mean)) "  median = " %5.2f (r(p50)) ///
              "  p25 = " %5.2f (r(p25)) "  SD across bank-years = " %5.2f (r(sd)) ///
              "  bank-years = " %8.0fc (r(N)) _n _n

*---- Section 4.1: municipalities per bank -----------------------------------------
use bankid muniid using "$work/BMY_unweighted_withconv.dta", clear
duplicates drop
collapse (count) n_muni = muniid, by(bankid)
qui sum n_muni, detail
file write ft "Sec 4.1  municipalities per bank: median = " %5.0f (r(p50)) ///
              "  p5 = " %5.0f (r(p5)) "  banks = " %4.0f (r(N)) _n _n

*---- Section 4.3: loan-growth sample ------------------------------------------------
use "$f_firm_bmy", clear
egen _tb = tag(bankid)
egen _tm = tag(muniid)
qui count if _tb
local nb = r(N)
qui count if _tm
local nm = r(N)
bysort muniid year: gen _n_by_my = _N
bysort muniid year: gen _first = _n == 1
qui sum _n_by_my if _first
local mean_by_my = r(mean)
bysort muniid bankid: gen _first_bm = _n == 1
bysort muniid: egen _n_by_m = total(_first_bm)
bysort muniid: gen _first_m = _n == 1
qui sum _n_by_m if _first_m
local mean_by_m = r(mean)
file write ft "Sec 4.3  loan-growth sample (bank x municipality file):" _n
file write ft "         banks = " %5.0f (`nb') "  municipalities = " %5.0f (`nm') _n
file write ft "         banks per municipality: mean over municipalities = " %5.1f (`mean_by_m') ///
              "  mean over municipality-years = " %5.1f (`mean_by_my') _n

file close ft
type "$tables/text_numbers.txt"
di as result "Step 9 done: $tables/text_numbers.txt"
